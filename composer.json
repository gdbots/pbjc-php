{
  "name": "gdbots/pbjc",
  "homepage": "https://github.com/gdbots/pbjc-php",
  "description": "Compiler for converting pbj schemas into jsonschema, php, js, etc.",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.5.12",
    "gdbots/pbj": "^4.0",
    "symfony/console": "^8.1",
    "symfony/filesystem": "^8.1",
    "symfony/finder": "^8.1",
    "symfony/yaml": "^8.1",
    "twig/twig": "^3.24"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3",
    "justinrainbow/json-schema": "^6.14"
  },
  "autoload": {
    "psr-4": {
      "Gdbots\\Pbjc\\": "src"
    }
  },
  "autoload-dev": {
    "psr-0": {
      "Gdbots\\Tests\\Pbjc\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "bin": [
    "bin/pbjc"
  ]
}
